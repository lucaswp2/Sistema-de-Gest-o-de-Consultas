@{
    ViewData["Title"] = "Início";
}

<div class="text-center">
    <h1 class="display-5 fw-bold">Sistema de Gestão de Consultas UVV</h1>
    <p class="lead">Cadastre-se, faça login e gerencie suas consultas médicas ou profissionais de forma simples e segura.</p>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a class="btn btn-primary btn-lg" asp-controller="Consultas" asp-action="Index">Ver minhas consultas</a>
    }
    else
    {
        <a class="btn btn-primary btn-lg me-2" asp-controller="Conta" asp-action="Cadastro">Criar conta</a>
        <a class="btn btn-outline-primary btn-lg" asp-controller="Conta" asp-action="Login">Entrar</a>
    }
</div>
